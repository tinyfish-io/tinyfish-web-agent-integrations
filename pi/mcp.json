{
  "mcpServers": {
    "tinyfish": {
      "url": "https://agent.tinyfish.ai/mcp",
      "headers": {
        "X-API-Key": "${TINYFISH_API_KEY}",
        "X-TF-Client-Name": "pi",
        "X-TF-Client-Version": "0.1.0"
      },
      "directTools": [
        "search",
        "fetch_content",
        "run_web_automation",
        "run_web_automation_async",
        "get_run",
        "cancel_run",
        "list_runs",
        "batch_status",
        "batch_cancel",
        "create_browser_session",
        "list_browser_sessions",
        "close_browser_session",
        "create_monitor",
        "list_monitors",
        "get_monitor",
        "pause_monitor",
        "resume_monitor",
        "run_monitor",
        "cancel_monitor",
        "list_profiles",
        "create_profile",
        "start_profile_setup_session",
        "save_profile_setup_session",
        "cancel_profile_setup_session",
        "get_wallet",
        "get_search_usage",
        "list_fetch_usage"
      ]
    }
  }
}
